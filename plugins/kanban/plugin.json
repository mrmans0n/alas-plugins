{
  "id": "io.nlopez.kanban",
  "name": "Kanban",
  "summary": "A ticket board for the project. Starting a ticket starts an agent in a new worktree.",
  "version": "0.4.0",
  "api": 12,
  "entry": "plugin.js",
  "web": "ui.js",
  "capabilities": ["workspace.read", "session.focus", "session.read", "tasks.start"],
  "contributes": {
    "tabs": [{ "id": "board", "title": "Board", "kind": "web" }],
    "commands": [{ "id": "open", "title": "Kanban board", "icon": "square.split.3x1", "slots": ["palette"], "opens": "board" }]
  }
}
